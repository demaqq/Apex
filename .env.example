# Copy to .env.local for development. Never commit real keys.
# Payments — Chapa (Ethiopia) or Stripe; PAYMENT_PROVIDER=sandbox for a local stand-in checkout.
CHAPA_SECRET_KEY=
STRIPE_SECRET_KEY=
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=ETB
# SMS — AfroMessage, Africa's Talking or Twilio; SMS_PROVIDER=log prints to the console.
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_PROVIDER=
SMS_ALLOWED_PREFIXES=+251
FACILITY_NAME=Northstar General
# If the app and API are on different domains:
ALLOWED_ORIGINS=
VITE_API_BASE=
